{
  "schemaVersion": 3,
  "project": {
    "name": "GetPatched",
    "repository": "getpatched/packaging-python-msgpack",
    "description": "Declarative, target-specific maintenance recipes for Debian's python-msgpack source package."
  },
  "package": {
    "source": "python-msgpack",
    "description": "Python implementation of the MessagePack serialization format.",
    "upstreamProject": "msgpack-python",
    "upstreamRepository": "https://github.com/msgpack/msgpack-python",
    "copyrightFile": "LICENSES/debian-source-copyright"
  },
  "targets": [
    {
      "id": "debian-bookworm-amd64",
      "file": "targets/debian/bookworm-amd64.json"
    },
    {
      "id": "debian-trixie-amd64",
      "file": "targets/debian/trixie-amd64.json"
    }
  ],
  "patchMetadata": "patches/metadata.json",
  "regressionTests": {
    "fixturesDirectory": "tests/fixtures",
    "runner": "getpatched/platform:verification/regression.py"
  },
  "licensing": {
    "publicContributionsSpdx": "MIT",
    "publicContributionsLicenseFile": "LICENSE",
    "earlyBinaryLicenseId": null,
    "earlyBinaryTermsFile": null,
    "upstreamCopyrightFile": "LICENSES/debian-source-copyright",
    "upstreamLicenses": "preserve"
  }
}
